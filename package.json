    "@types/react-dom": "^19",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.184.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "5.5"
