{
  "name": "nepal-weather-decision-map",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "prebuild": "tsx scripts/check/public-asset-budget.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "biome check --write src/",
    "format": "biome format --write src/",
    "check": "biome check src/ && npx tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed-places": "tsx scripts/db/seed-places.ts",
    "db:studio": "drizzle-kit studio",
    "db:openmeteo-historical": "tsx --env-file=.env.local scripts/ingestion/openmeteo-historical/run.ts",
    "db:openmeteo-aq": "tsx --env-file=.env.local scripts/ingestion/openmeteo-aq/run.ts",
    "db:icimod-mb": "tsx --env-file=.env.local scripts/ingestion/icimod-mb/run.ts",
    "db:hugonnet-2021": "tsx --env-file=.env.local scripts/ingestion/hugonnet-2021/run.ts",
    "db:usgs-earthquakes": "tsx --env-file=.env.local scripts/ingestion/usgs-earthquakes/run.ts",
    "db:firms-historical": "tsx --env-file=.env.local scripts/ingestion/firms-historical/run.ts",
    "icimod:download": "tsx --env-file=.env.local scripts/scrape-icimod-downloads/run.ts",
    "transform:icimod-glacier-decades": "tsx --env-file=.env.local scripts/transform/icimod-glacier-decades/run.ts",
    "transform:icimod-glacial-lakes": "tsx scripts/transform/icimod-glacial-lakes/run.ts",
    "transform:water-cycle-dem": "tsx --env-file=.env.local scripts/transform/water-cycle/download-dem.ts",
    "validate:water-cycle-provenance": "tsx scripts/transform/water-cycle/validate-provenance.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@vercel/blob": "^2.3.3",
    "drizzle-orm": "^0.45.2",
    "maplibre-gl": "^5.24.0",
    "next": "^15.5.18",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-map-gl": "^8.1.1",
    "suncalc": "^1.9.0",
    "swr": "^2.4.1",
    "three": "^0.184.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.19.8",
    "@playwright/test": "^1.45.0",
    "@tailwindcss/postcss": "^4",
    "@turf/area": "^7.3.5",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/shapefile": "^0.6.4",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.184.1",
    "@types/yauzl": "^2.10.3",
    "@vitest/ui": "^1.6.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "mapshaper": "^0.7.12",
    "playwright": "^1.59.1",
    "proj4": "^2.20.8",
    "shapefile": "^0.6.6",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "5.5",
    "vitest": "^1.6.0",
    "yauzl": "^3.3.0"
  }
}
