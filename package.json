    "db:openmeteo-historical": "tsx --env-file=.env.local scripts/ingestion/openmeteo-historical/run.ts",
    "db:openmeteo-aq": "tsx --env-file=.env.local scripts/ingestion/openmeteo-aq/run.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@vercel/blob": "^2.3.3",
    "drizzle-orm": "^0.45.2",
    "maplibre-gl": "^5.24.0",
    "next": "^15.5.18",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-map-gl": "^8.1.1",
    "suncalc": "^1.9.0",
    "swr": "^2.4.1",
    "three": "^0.184.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@eslint/eslintrc": "^3",
