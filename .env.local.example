# Copy this file to .env.local and fill in the real values.
# Never commit .env.local — it contains write-access secrets.

# Preferred for local dev — storeId only (no write access needed to read the public manifest).
# Find it in: Vercel dashboard → Storage → your blob store → Settings
# It is the segment that looks like "b4g2j8qv8kuneoz6" in the public URL.
HIMAWARI_STORE_ID=b4g2j8qv8kuneoz6

# Full write token — only needed for the GitHub Actions pipeline (himawari.yml).
# Also accepted by /api/himawari as a fallback if HIMAWARI_STORE_ID is not set.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXX_XXXX
