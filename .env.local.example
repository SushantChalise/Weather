# Copy this file to .env.local and fill in the real values.
# Never commit .env.local — it contains write-access secrets.

# Vercel Blob store token — copy from Vercel dashboard:
# Storage → your blob store → Settings → Tokens
# The /api/himawari route uses this to locate the public manifest URL.
# Format: vercel_blob_rw_{storeId}_{hash}
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXX_XXXX
